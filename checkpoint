#!/usr/bin/env zsh

hello(){
	local s=$1
	echo "Hello $1 !"
}

goodbye(){
	local s=$1
	echo "Goodbye $s !"
}

deflt(){
	s=$1
	echo "$s is in default case."
}

if (($# == 0 )); then
	echo 'No argument!'
	exit 1
fi

for name in "$@"; do
	case "$name" in
		*s*) 
			hello "$name"
			;;
		b*)
			goodbye "$name"
			;;
		*)	
			deflt "$name"
			;;	
	esac
		
done

	
